# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/master/Unity.gitignore
#
# *.meta files in the Assets folder and its subfolders now get included
# Uncomment this line if you want to exclude the entire Assets folder
# /Assets/

# Logs
/[Ll]ogs/
/[Ll]og/

# Memory Crashes
MemoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.png
!/[Aa]ssets/**/*.jpg
!/[Aa]ssets/**/*.jpeg
!/[Aa]ssets/**/*.gif
!/[Aa]ssets/**/*.gimp
!/[Aa]ssets/**/*.psd
!/[Aa]ssets/**/*.tga
!/[Aa]ssets/**/*.tif
!/[Aa]ssets/**/*.tiff
!/[Aa]ssets/**/*.iff
!/[Aa]ssets/**/*.pict
!/[Aa]ssets/**/*.dds
!/[Aa]ssets/**/*.aif
!/[Aa]ssets/**/*.aiff
!/[Aa]ssets/**/*.wav
!/[Aa]ssets/**/*.wave
!/[Aa]ssets/**/*.ogg
!/[Aa]ssets/**/*.mp3
!/[Aa]ssets/**/*.mp4
!/[Aa]ssets/**/*.ogv
!/[Aa]ssets/**/*.mov
!/[Aa]ssets/**/*.mts
!/[Aa]ssets/**/*.m2ts
!/[Aa]ssets/**/*.mxf
!/[Aa]ssets/**/*.wmv
!/[Aa]ssets/**/*.flv
!/[Aa]ssets/**/*.asf
!/[Aa]ssets/**/*.avi
!/[Aa]ssets/**/*.mov
!/[Aa]ssets/**/*.webm
!/[Aa]ssets/**/*.mkv
!/[Aa]ssets/**/*.3gp
!/[Aa]ssets/**/*.3g2
!/[Aa]ssets/**/*.mj2
!/[Aa]ssets/**/*.mid
!/[Aa]ssets/**/*.midi
!/[Aa]ssets/**/*.kar
!/[Aa]ssets/**/*.mp4a
!/[Aa]ssets/**/*.weba
!/[Aa]ssets/**/*.ra
!/[Aa]ssets/**/*.pac
!/[Aa]ssets/**/*.parec
!/[Aa]ssets/**/*.ape
!/[Aa]ssets/**/*.spx
!/[Aa]ssets/**/*.snd
!/[Aa]ssets/**/*.au
!/[Aa]ssets/**/*.flac
!/[Aa]ssets/**/*.caf
!/[Aa]ssets/**/*.fap
!/[Aa]ssets/**/*.wv
!/[Aa]ssets/**/*.f4a
!/[Aa]ssets/**/*.f4b
!/[Aa]ssets/**/*.aac
!/[Aa]ssets/**/*.opus
!/[Aa]ssets/**/*.wma
!/[Aa]ssets/**/*.drflac
!/[Aa]ssets/**/*.it
!/[Aa]ssets/**/*.mod
!/[Aa]ssets/**/*.s3m
!/[Aa]ssets/**/*.xm
!/[Aa]ssets/**/*.fbx
!/[Aa]ssets/**/*.blend
!/[Aa]ssets/**/*.blend1
!/[Aa]ssets/**/*.blend2
!/[Aa]ssets/**/*.blend3
!/[Aa]ssets/**/*.blend4
!/[Aa]ssets/**/*.blend5
!/[Aa]ssets/**/*.unitypackage
!/[Aa]ssets/**/*.rar
!/[Aa]ssets/**/*.7z
!/[Aa]ssets/**/*.zip
!/[Aa]ssets/**/*.tar
!/[Aa]ssets/**/*.tar.gz
!/[Aa]ssets/**/*.exe
!/[Aa]ssets/**/*.jar
!/[Aa]ssets/**/*.dll
